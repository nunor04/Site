{
  "manifest_version": 3,
  "name": "Scrolly Kirk",
  "version": "1.8.0",
  "description": "Instagram with a per-video volume control and other Scrolly Kirk modifications.",
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "volume.js",
        "mostviewed.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "scrolly-kirk@nunor04.github.io",
      "strict_min_version": "115.0"
    }
  }
}
