{
  "name": "scrolly-kirk",
  "version": "1.7.2",
  "private": true,
  "description": "Scrolly Kirk: Instagram in a phone-style window",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "check-secrets": "node scripts/check-secrets.js",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.scrollykirk.app",
    "productName": "Scrolly Kirk",
    "files": [
      "main.js",
      "extension/*.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Scrolly-Kirk-${version}.exe"
    }
  }
}
